# PracticeHub — Environment Variables
# Copy to .env and fill in values

# ---------- Database ----------
# Local dev (SQLite, zero-config)
DATABASE_URL="file:./dev.db"
# Production (Vercel Postgres / Neon / Supabase) — switch provider in prisma/schema.prisma to postgresql first
# DATABASE_URL="postgresql://user:password@host:5432/practicehub?sslmode=require"
# For Vercel Postgres with pooling:
# DATABASE_URL="postgres://default:xxx@xxx-pooler.xxx.vercel-storage.com/verceldb?sslmode=require"
# DIRECT_URL="postgres://default:xxx@xxx.xxx.vercel-storage.com/verceldb?sslmode=require"

# ---------- Auth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# For Vercel production:
# NEXTAUTH_URL="https://your-app.vercel.app"

# ---------- OAuth (optional) ----------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ---------- Storage (Production) ----------
# Vercel filesystem is ephemeral — use R2/S3 for uploads in production
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="practicehub-uploads"
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ---------- OCR (Phase 9) ----------
# Azure Document Intelligence — optional, falls back to Tesseract.js
# AZURE_DI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com"
# AZURE_DI_KEY="<your-key>"
# AZURE_DI_ENABLED="true"

# ---------- AI (Phase 10) ----------
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_PROVIDER="openai"  # openai | anthropic | mock
