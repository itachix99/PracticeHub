# PracticeHub — Environment Variables
# Copy to .env and fill in values. DO NOT commit .env.

# ---------- Database ----------
# Local dev (SQLite, zero-config) — keep file:./dev.db for local dev until you run docker-compose
DATABASE_URL="file:./dev.db"
# Production (Vercel Postgres / Neon / Supabase) — IMPORTANT: switch provider in prisma/schema.prisma to postgresql, then:
# DATABASE_URL="postgresql://user:password@host:5432/practicehub?sslmode=require"
# For Vercel Postgres with pooling (recommended):
# DATABASE_URL="postgres://default:xxx@xxx-pooler.xxx.vercel-storage.com/verceldb?sslmode=require"
# DIRECT_URL="postgres://default:xxx@xxx.xxx.vercel-storage.com/verceldb?sslmode=require"

# ---------- Auth ----------
# Generate with: openssl rand -base64 32  (must be >=32 chars, not the placeholder below)
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32-REPLACE-IN-PROD"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32-REPLACE-IN-PROD"
NEXTAUTH_URL="http://localhost:3000"
# For Vercel production:
# NEXTAUTH_URL="https://your-app.vercel.app"

# ---------- OAuth (optional) ----------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ---------- Storage (Production) ----------
# Vercel filesystem is ephemeral — MUST set R2/S3 for uploads in production
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="practicehub-uploads"
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"
# Alternative: Vercel Blob or S3 — adapt lib/storage/index.ts via isR2Configured()

# ---------- Security ----------
# TRUST_PROXY="1"  # set to 1 only behind Vercel/Cloudflare where X-Forwarded-For is trusted
# UPSTASH_REDIS_REST_URL=""  # for distributed rate limiting in production
# UPSTASH_REDIS_REST_TOKEN=""

# ---------- OCR (Phase 9) ----------
# Azure Document Intelligence — optional, falls back to Tesseract.js
# AZURE_DI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com"
# AZURE_DI_KEY="<your-key>"
# AZURE_DI_ENABLED="true"

# ---------- AI (Phase 10) ----------
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_PROVIDER="openai"  # openai | anthropic | mock
