# Database — Phase 2 uses SQLite for local dev. For production, switch to PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/practicehub?schema=public"
DATABASE_URL="file:./dev.db"
# Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# OAuth (optional for Phase 2 — add in Phase 2 if you want Google login)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# OCR - Azure Document Intelligence (Phase 9) - optional, falls back to Tesseract
# AZURE_DI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com"
# AZURE_DI_KEY="<your-key>"
# AZURE_DI_ENABLED="true"  # set false to force Tesseract even if configured

# AI - Question Extraction (Phase 10) - choose provider, fallback to heuristic mock if no key
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_PROVIDER="openai"  # openai | anthropic | mock (default mock when no key)
